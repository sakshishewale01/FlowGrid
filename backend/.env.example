# ==============================================================================
# FlowGrid - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to `.env` in the `backend/` directory:
#      cp .env.example .env (Linux/macOS)
#      Copy-Item .env.example .env (Windows PowerShell)
# 2. Never commit your actual `.env` file containing sensitive credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Environment
# ------------------------------------------------------------------------------
APP_NAME=FlowGrid
# Environment mode: 'development', 'staging', or 'production'
APP_ENV=development
# Set DEBUG=False in staging/production environments to disable stack traces
DEBUG=True
# Log level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Server Binding & Network
# ------------------------------------------------------------------------------
# In local development: 127.0.0.1. In Docker/Production: 0.0.0.0
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Allowed origins for frontend clients. Supports JSON list or comma-separated strings:
# Development: ["http://localhost:5173", "http://127.0.0.1:5173"]
# Production: ["https://app.flowgrid.io", "https://admin.flowgrid.io"]
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_STRONG_PASSWORD@localhost:5432/flowgrid_db

# ------------------------------------------------------------------------------
# 5. Security & JWT Authentication
# ------------------------------------------------------------------------------
# CRITICAL SECURITY NOTE:
# In production, SECRET_KEY must be a cryptographically secure random string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=flowgrid_super_secret_development_key_32_bytes_min_length_123!
ALGORITHM=HS256
# Token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
