# ==============================================================================
# FlowGrid - Environment Variables Template
# Copy this file to .env in the backend/ directory for local development:
#   cp .env.example .env (or 'Copy-Item .env.example .env' on Windows PowerShell)
# ==============================================================================

# Application Metadata
APP_NAME=FlowGrid
APP_ENV=development
DEBUG=True

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL + SQLAlchemy 2.0 + psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/flowgrid_db

# Security & JWT Authentication (Phase 4)
# Generate a secure secret in production, e.g. with: openssl rand -hex 32
SECRET_KEY=flowgrid_super_secret_development_key_32_bytes_min_length_123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
