# ==============================================================================
# FlowGrid - Environment Variables Template
# Copy this file to .env in the backend/ directory for local development:
#   cp .env.example .env (or 'Copy-Item .env.example .env' on Windows PowerShell)
# ==============================================================================

# Application Metadata
APP_NAME=FlowGrid
APP_ENV=development
DEBUG=True

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
# A list of frontend URLs permitted to communicate with this backend API.
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL + SQLAlchemy 2.0 + psycopg 3)
# Replace placeholder credentials with your local or cloud PostgreSQL instance.
# Never commit real credentials to version control.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/flowgrid_db
